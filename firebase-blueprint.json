{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered or authenticated candidate account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "Candidate resume vs job description readiness analysis record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "company": { "type": "string" },
        "readinessScore": { "type": "number" },
        "readinessState": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "jobTitle", "readinessScore", "readinessState", "createdAt"]
    },
    "Resume": {
      "title": "Resume",
      "description": "Generated ATS-tailored resume document and verification audit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "analysisId": { "type": "string" },
        "userId": { "type": "string" },
        "markdownContent": { "type": "string" },
        "atsFormatCompliance": { "type": "boolean" },
        "generatedAt": { "type": "string" }
      },
      "required": ["id", "analysisId", "markdownContent", "generatedAt"]
    },
    "SkillProfile": {
      "title": "SkillProfile",
      "description": "Candidate canonical verified skill inventory",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "updatedAt"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Candidate tracked job application and status pipeline",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "company": { "type": "string" },
        "jobSource": { "type": "string" },
        "status": { "type": "string" },
        "appliedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "jobId", "jobTitle", "company", "jobSource", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Candidate profile document"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "Job description and resume evaluation record"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Generated tailored resumes and ATS audits"
    },
    "/users/{userId}/skill_profiles/{profileId}": {
      "schema": "SkillProfile",
      "description": "Verified candidate skills ledger"
    },
    "/users/{userId}/applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Candidate job applications and pipeline tracking"
    }
  }
}
